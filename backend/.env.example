# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or Atlas URI)
# Example Local: mongodb://localhost:27017/milan_clothing_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/milan_clothing_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/milan_clothing_db

# Client URL (for CORS)
CLIENT_URL=http://localhost:5174
